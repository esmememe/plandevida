# --- Tu usuario ---
ALLOWED_EMAIL=esmeraldagr92@gmail.com
TIMEZONE=America/Mexico_City
# Correos separados por comas (puede ir vacío)
PRIORITY_SENDERS=
# URL pública de la app, sin "/" al final (en local: http://localhost:3000)
APP_URL=http://localhost:3000

# --- Supabase (Project Settings > API) ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# --- Google Cloud (Credenciales > ID de cliente OAuth) ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Anthropic ---
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5

# --- Resend (opcional: sin esto no se envía el resumen por correo) ---
RESEND_API_KEY=
# Sin dominio propio usa: Panel de Vida <onboarding@resend.dev>
RESEND_FROM=Panel de Vida <onboarding@resend.dev>

# --- Seguridad (genera cada una con: openssl rand -base64 32) ---
CRON_SECRET=
TOKEN_ENCRYPTION_KEY=

# --- Opcional: horario de trabajo para calcular tiempo libre ---
WORKDAY_START=8
WORKDAY_END=20
